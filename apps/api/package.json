{
  "name": "@chinatalent/api",
  "version": "0.1.0",
  "private": true,
  "description": "China Talent Bridge backend API (Express)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@chinatalent/shared": "*",
    "@sentry/node": "^10.59.0",
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
}
