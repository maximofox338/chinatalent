# China Talent Bridge — API environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase anon/public key (safe for clients)
SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, bypasses RLS. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string from Supabase (Project Settings → Database)
DATABASE_URL=

# Runtime environment: development | staging | production
NODE_ENV=

# Port the API server listens on
PORT=

# Allowed browser origin(s) for CORS, comma-separated. Defaults to the local
# Vite dev server when unset. Set to the deployed frontend URL in staging/prod,
# e.g. https://app.chinatalentbridge.com
CORS_ORIGIN=http://localhost:5173

# Sentry DSN for backend error/perf monitoring. Leave blank to disable
# (Sentry is skipped entirely when unset — fine for local dev).
SENTRY_DSN=
