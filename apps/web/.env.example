# China Talent Bridge — Web environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# NOTE: Vite exposes every VITE_* variable to the browser — never put secrets here.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser)
VITE_SUPABASE_ANON_KEY=

# Base URL of the backend API, e.g. http://localhost:3000
VITE_API_URL=
